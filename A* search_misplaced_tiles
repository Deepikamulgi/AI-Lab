import heapq

GOAL = (
    1, 2, 3,
    8, 0, 4,
    7, 6, 5
)


# Heuristic: Number of misplaced tiles
def misplaced_tiles(state):
    count = 0

    for i in range(9):
        if state[i] != 0 and state[i] != GOAL[i]:
            count += 1

    return count


# Generate possible next states
def get_neighbors(state):
    neighbors = []

    blank = state.index(0)

    row = blank // 3
    col = blank % 3

    moves = [
        (-1, 0, "Up"),
        (1, 0, "Down"),
        (0, -1, "Left"),
        (0, 1, "Right")
    ]

    for dr, dc, move in moves:

        new_row = row + dr
        new_col = col + dc

        if 0 <= new_row < 3 and 0 <= new_col < 3:

            new_blank = new_row * 3 + new_col

            new_state = list(state)

            # Swap blank with the selected tile
            new_state[blank], new_state[new_blank] = (
                new_state[new_blank],
                new_state[blank]
            )

            neighbors.append((tuple(new_state), move))

    return neighbors


# Print puzzle in 3 x 3 format
def print_puzzle(state):
    for i in range(0, 9, 3):
        print(state[i:i + 3])
    print()


# A* Search Algorithm
def a_star(start):

    priority_queue = []

    g = 0
    h = misplaced_tiles(start)
    f = g + h

    heapq.heappush(
        priority_queue,
        (f, g, start, [])
    )

    visited = set()

    while priority_queue:

        f, g, current, path = heapq.heappop(priority_queue)

        if current in visited:
            continue

        visited.add(current)

        # Goal test
        if current == GOAL:
            return path, g

        # Generate neighboring states
        for next_state, move in get_neighbors(current):

            if next_state in visited:
                continue

            new_g = g + 1
            h = misplaced_tiles(next_state)
            new_f = new_g + h

            new_path = path + [(next_state, move)]

            heapq.heappush(
                priority_queue,
                (new_f, new_g, next_state, new_path)
            )

    return None, -1


# Main program
print("8-PUZZLE A* - MISPLACED TILES")

print("Enter initial state (0 represents blank):")

start = []

for i in range(3):
    row = list(map(int, input().split()))
    start.extend(row)

start = tuple(start)

print("\nInitial State:")
print_puzzle(start)

path, cost = a_star(start)

if path is None:

    print("No solution found.")

else:

    print("Solution Found!")
    print("Total Cost / Depth:", cost)
    print("Heuristic: Misplaced Tiles")

    print("\nSolution Path:")

    print("Initial State:")
    print_puzzle(start)

    for i, (state, move) in enumerate(path):

        print("Move", i + 1, ":", move)
        print_puzzle(state)
